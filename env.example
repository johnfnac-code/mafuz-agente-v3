# ===== Variáveis da Railway (painel "Variables") · Gabi v4.3 =====
# Nunca coloque os valores reais em repositório.

# --- Z-API ---
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
# Z-API > Segurança > "Token de segurança da conta"
ZAPI_CLIENT_TOKEN=

# --- Imoview ---
IMOVIEW_API_KEY=
IMOVIEW_ENVIAR_LEADS=false
IMOVIEW_MIDIA_LEAD=WhatsApp - Gabi

# --- Modelo de linguagem ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# --- Segurança ---
WEBHOOK_SECRET=
ADMIN_TOKEN=

# --- Equipe (formato 5531999999999, separados por vírgula) ---
# Gestão: recebe TODOS os alertas e pode mandar comandos (#status, #pausar...)
TEAM_PHONES=
ADMIN_PHONES=
# Corretores por carteira: recebem pedidos de corretor e de visita
TEAM_VENDA=5531989097232,5531988093993
TEAM_LOCACAO=5531987176953,5531994099755,5531999549025
NOME_EQUIPE=um dos nossos corretores

# --- Site ---
SITE_URL=https://mafuz.site
# Sites autorizados a usar a Gabi pelo chat (/site/chat)
SITE_CHAT_ORIGINS=https://mafuz.site,https://www.mafuz.site

# --- Ritmo humano ---
DEBOUNCE_MS=4000
DEBOUNCE_VARIACAO_MS=3000
MAX_MENSAGENS=2
ENVIAR_FOTOS=true
# Silêncio depois que um corretor responde pelo número da Mafuz (volta sozinha depois disso)
PAUSA_HUMANO_MIN=60

# --- Reengajamento ---
REENGAJAMENTO=true
CUTUCADA_MIN=15
FOLLOWUP_DIAS=3,7
# Janela de envio proativo (dia da semana 0=domingo): seg a sáb, 8h às 21h
JANELA_ENVIO=1-6 08:00-21:00

# --- Comportamento ---
BOT_ATIVO=true
MODO_OPERACAO=24h
HORARIO_COMERCIAL=1-5 09:00-18:00; 6 09:00-13:00
HORARIO_VISITAS=1-5 09:00-18:00; 6 09:00-13:00
TRANSCREVER_AUDIO=true
CONVERSA_TTL_DIAS=15

# Volume da Railway montado em /app/data (conversas sobrevivem aos deploys)
DATA_DIR=/app/data

# --- v4.2 · carteira ao vivo, radar, agenda, vídeos, painel ---
# Endereço público deste servidor (vídeos e links)
PUBLIC_URL=https://mafuz-agente-production.up.railway.app
CATALOGO_SYNC_MIN=15
RADAR=true
RADAR_INTERVALO_HORAS=20
RADAR_MAX_IMOVEIS=2
RADAR_VALIDADE_DIAS=60
# Google Agenda: JSON da conta de serviço (em uma linha) e telefone=email de cada corretor
GOOGLE_SERVICE_ACCOUNT_JSON=
AGENDA_CORRETORES=
AGENDA_CRIAR_EVENTO=true
AGENDA_DIAS=7
VISITA_DURACAO_MIN=60
VIDEO_AUTOMATICO=true
VIDEO_NO_WHATSAPP=true
VIDEO_MAX_POR_CICLO=6
UTM_LINKS=true
UTM_SOURCE=whatsapp
UTM_MEDIUM=gabi
# Supabase do site (painel de conversas valida o login). Troque ao migrar para o projeto próprio.
SITE_SUPABASE_URL=
SITE_SUPABASE_ANON_KEY=

# --- v4.3 · resumo das 8h, pós-visita, 2º Cérebro e Instagram ---
RESUMO_8H=true
RESUMO_HORA=8
# 0=domingo ... 6=sábado
RESUMO_DIAS=1,2,3,4,5,6
POS_VISITA=true
POS_VISITA_HORAS=2
# telefone=nome de cada corretor (aparece no "Bom dia, ...")
NOMES_CORRETORES=5531989097232=Marcella,5531988093993=Thais,5531987176953=Raina,5531994099755=Ana Flavia,5531999549025=Catia
# Token de longa duração da API do Instagram (conta Profissional). O servidor renova sozinho.
INSTAGRAM_TOKEN=
INSTAGRAM_PERFIL=mafuzimoveisdeluxo
